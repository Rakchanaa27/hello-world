<?xml version="1.0" encoding="UTF-8"?>
<sequence name="tel-Employee-Payroll-v1-employeevalidation-sequence" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
<filter xpath="string-length(normalize-space($ctx:payrollMonth)) = 0">
        <then>
            <property name="HTTP_SC" value="400" scope="axis2" type="STRING"/>
            <payloadFactory media-type="json">
                <format>
                    {
                    "error":"INVALID_PAYROLLMONTH",
                    "errorMessage":"payrollMonth is invalid or empty."
                    }
                </format>
            </payloadFactory>
            <respond/>
        </then>
    </filter>
    <filter xpath="string-length(normalize-space($ctx:department)) = 0">
        <then>
            <property name="HTTP_SC" value="400" scope="axis2" type="STRING"/>
            <payloadFactory media-type="json">
                <format>
                    {
                    "error":"INVALID_DEPARTMENT",
                    "errorMessage":"department is invalid or empty."
                    }
                </format>
            </payloadFactory>
            <respond/>
        </then>
    </filter>
</sequence>