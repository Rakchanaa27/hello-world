<?xml version="1.0" encoding="UTF-8"?>
<api context="/loanProcessingAPI" name="LoanProcessingAPI" version="1.0.0" version-type="url" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="GET" uri-template="/status" inSequence="creditScoreSeq">
    <inSequence>
    <log level="custom">
        <property name="Status" value="Calculate credit score"/>
    </log>

    <call>
        <endpoint key="endpointsStatus"/>
    </call>

    <payloadFactory media-type="json">
        <format>
            {
              "plan":"credit"
            }
        </format>
        <args/>
    </payloadFactory>
    <respond/>
    </inSequence>
    </resource>
  

</api>




